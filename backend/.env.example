# Copy to .env for local development. On Render, set these in Environment → Environment Variables.

# MySQL connection (Railway: use the PUBLIC URL, e.g. mysql://root:PASSWORD@xxxx.proxy.rlwy.net:12345/railway)
DATABASE_URL=mysql://root:password@localhost:3306/dinapoli_vitrine

# Long random string used to sign admin sessions (generate one, never reuse the example)
JWT_SECRET=change-me

# Admin account created/updated at startup (password is reset to this value on every start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Front-end address(es) allowed to call the API, comma-separated, no trailing slash
CORS_ORIGIN=http://localhost:5173

# Optional
PORT=3000
GEOCODE_COUNTRY=tn
# SEED_DEMO=true   # adds demo restaurants, a "Pizzas" menu and 2 dishes (local only)
